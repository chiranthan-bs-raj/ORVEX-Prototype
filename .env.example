# Copy to .env for local use (never commit .env). All values below are placeholders.

# Where the videos and the 3 large tables are served from (public Hugging Face dataset). Leave empty to use local files under data/.
ORVEX_MEDIA_BASE=https://huggingface.co/datasets/YOUR_HF_USERNAME/ORVEX-Prototype-Media/resolve/main

# Signing key for login tokens. Generate one:  python -c "import secrets; print(secrets.token_hex(32))"
# If unset, a random key is created in the app folder on first start (tokens then stop working after a rebuild).
ORVEX_SECRET=change-me

# Folder for the SQLite database (users, investigations, reviews), uploads and thumbnails. Must be writable.
ORVEX_APP_DIR=./data/app

# Optional
ORVEX_CORS=*                 # comma-separated allowed origins; * is fine because the app is served from one origin
ORVEX_LOG=INFO
ORVEX_FFMPEG=                # path to ffmpeg if it is not on PATH
ORVEX_CONTACT=               # only for scripts/datasets (User-Agent contact when fetching metadata)
