# Copy to .env on the server (never commit .env). Placeholders only.
# Free hostname that points at your server IP, e.g. 203.0.113.10.sslip.io (any domain you own also works)
SITE_ADDRESS=YOUR_SERVER_IP.sslip.io
# Generate on the server:  openssl rand -hex 32
ORVEX_SECRET=change-me
# Optional: where the videos are served from (default is the public Hugging Face dataset)
# ORVEX_MEDIA_BASE=https://huggingface.co/datasets/chiranthanbsraj/ORVEX-Prototype-Media/resolve/main
